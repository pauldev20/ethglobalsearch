# --- Convex self-host backend ---
# Generate with `openssl rand -hex 32` (or any random hex string)
INSTANCE_NAME=ethsearch
INSTANCE_SECRET=replace_me_with_64_hex_chars


# Public-facing URLs the Convex backend advertises.
# CONVEX_CLOUD_ORIGIN — main API (queries/mutations/actions), maps to container :3210.
# CONVEX_SITE_ORIGIN — HTTP actions endpoint, maps to container :3211.
# If you don't use httpAction routes, SITE can equal CLOUD (just needs a value).
CONVEX_CLOUD_ORIGIN=https://api.ethsearch.yourdomain.com
CONVEX_SITE_ORIGIN=https://api.ethsearch.yourdomain.com

# Host ports (defaults work for local)
PORT=3210
SITE_PROXY_PORT=3211

# Postgres — POSTGRES_DB MUST equal INSTANCE_NAME with `-` replaced by `_`.
# INSTANCE_NAME=ethsearch       → POSTGRES_DB=ethsearch
# INSTANCE_NAME=convex-self-hosted (default) → POSTGRES_DB=convex_self_hosted
POSTGRES_USER=convex
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=ethsearch

# External S3 / S3-compatible (R2, B2, Wasabi, MinIO elsewhere, etc.)
AWS_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=                 # e.g. https://<acct>.r2.cloudflarestorage.com — leave empty for AWS S3
AWS_S3_FORCE_PATH_STYLE=true     # true for R2/MinIO, false for AWS S3
S3_STORAGE_EXPORTS_BUCKET=convex-exports
S3_STORAGE_FILES_BUCKET=convex-files
S3_STORAGE_MODULES_BUCKET=convex-modules
S3_STORAGE_SEARCH_BUCKET=convex-search
S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=convex-snapshots

# --- Next.js web (only this one is needed at runtime) ---
NEXT_PUBLIC_CONVEX_URL=https://api.ethsearch.yourdomain.com

# Optional analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_URL=

# --- Convex deploy (used by web Dockerfile during build via `convex deploy --cmd`) ---
# Generate the admin key once after first backend boot:
#   docker compose exec backend ./generate_admin_key.sh
# Paste it below. The web image build will push convex/ code on every rebuild.
CONVEX_SELF_HOSTED_URL=https://api.ethsearch.yourdomain.com
CONVEX_SELF_HOSTED_ADMIN_KEY=

# After deploy, set secrets / kick off ingest from your local shell:
#   export CONVEX_SELF_HOSTED_URL=https://api.ethsearch.yourdomain.com
#   export CONVEX_SELF_HOSTED_ADMIN_KEY=<paste>
#   bunx convex env set OPENROUTER_API_KEY <key>
#   bunx convex env set EMBEDDINGS_MODEL qwen/qwen3-embedding-8b
#   bunx convex env set OPENROUTER_REFERER https://ethsearch.yourdomain.com  # attribution shown in OpenRouter dashboard
#   bunx convex run ingest:scheduleSyncAll
